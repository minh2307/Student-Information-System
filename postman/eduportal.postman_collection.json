        {
          "name": "3.3 PUT /lecturer/enrollments/{id}/attendance — Cập nhật chuyên cần (95% -> 9.5 điểm)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_lecturer}}",
                "type": "text"
