{
  "expo": {
    "name": "Rikkei EduPortal",
    "slug": "rikkei-eduportal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rikkei-eduportal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rikkei.eduportal",
      "supportsTablet": false,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.rikkei.eduportal",
      "adaptiveIcon": {
        "backgroundColor": "#7F1D1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7F1D1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Rikkei EduPortal truy cập máy ảnh để quét mã QR điểm danh."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7F1D1D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "98debee5-fa5d-4f4c-b4b8-196c9a8eddc8"
      }
    },
    "owner": "minh2307"
  }
}
