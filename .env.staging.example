# ==============================================================================
# Rikkei EduPortal - Staging Environment Configuration Template
# FILE: .env.staging.example
# INSTRUCTIONS: Copy this file to .env.staging and fill in real values.
# NEVER commit .env.staging to version control.
# ==============================================================================

# Database Configuration (Staging PostgreSQL - Isolated Instance)
DB_USER=postgres
DB_PASSWORD=your_secure_staging_db_password_here
DB_NAME=academic_db
DB_PORT=15432

# Security & Authentication
# 256-bit secret key for HMAC-SHA256 signing
JWT_SECRET=your_staging_jwt_secret_min_32_characters_here!!
JWT_EXPIRATION_MS=900000

# AI Service Integration (OpenRouter / Gemini)
AI_API_KEY=your_openrouter_or_gemini_api_key_here
AI_BASE_URL=https://openrouter.ai/api
AI_MODEL=google/gemini-2.5-flash
AI_PROVIDER=openrouter
AI_MAX_TOKENS=1500

# PayOS Payment Gateway (Staging / Sandbox Credentials)
PAYOS_CLIENT_ID=your_sandbox_client_id
PAYOS_API_KEY=your_sandbox_api_key
PAYOS_CHECKSUM_KEY=your_sandbox_checksum_key_32bytes_long!!
PAYOS_RETURN_URL=http://localhost:8080/student/tuition?status=PAID
PAYOS_CANCEL_URL=http://localhost:8080/student/tuition?status=CANCELLED

# JVM Deep Tuning: 80MB Heap, 256KB Thread Stack, 65MB Metaspace Cap
JAVA_OPTS=-Xmx80m -Xms32m -Xss256k -XX:MaxMetaspaceSize=65m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:ReservedCodeCacheSize=20m

# Container & Image Registry Tags
IMAGE_PREFIX=
IMAGE_TAG=latest

# Secure Loopback Port Mapping (Không xung đột với Development stack)
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8080
AUTH_PORT=18081
COURSE_PORT=18082
ENROLLMENT_PORT=18083
AI_PORT=18084
LECTURER_PORT=18085
